# Port HTTP + WebSocket
PORT=4000

# Origin frontend yang diizinkan (CORS). Pisahkan dengan koma, atau * untuk semua.
CLIENT_ORIGIN=http://localhost:5173

# Lokasi file database SQLite
DB_PATH=./data/dashboard.db

# Generator data berkala (cron). Interval dalam detik.
ENABLE_GENERATOR=true
GENERATOR_INTERVAL_SEC=2

# Integrasi API kurs mata uang publik (tanpa API key)
ENABLE_RATES=true
RATES_API_URL=https://open.er-api.com/v6/latest
RATES_BASE=USD
RATES_TARGETS=IDR,EUR,JPY
RATES_REFRESH_MIN=5